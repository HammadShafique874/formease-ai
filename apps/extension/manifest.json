{
  "manifest_version": 3,
  "name": "FormEase AI",
  "version": "0.1.0",
  "description": "Understand every form question. Field detection runs here; AI explanations run in the FormEase web app.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FormEase AI"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://formease-ai-933b6.web.app/*",
    "http://localhost:5173/*"
  ]
}
