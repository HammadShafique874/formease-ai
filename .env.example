# FormEase AI — copy to .env (web) / never commit real values.
# Firebase is NOT configured yet (Phase 2). Leave blank until Phase 5.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA Enterprise site key for App Check (web only, Phase 5)
VITE_APPCHECK_SITE_KEY=
# Set to "true" ONLY for local dev debug tokens; never in production
VITE_APPCHECK_DEBUG=false
# Explicit debug token registered in Firebase Console (dev only) — leave blank in the example
VITE_APPCHECK_DEBUG_TOKEN=
# Hosted dashboard URL used by the extension (Phase 5: replace with hosted URL)
VITE_DASHBOARD_URL=http://localhost:5173/#/dashboard
